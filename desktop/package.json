{
  "name": "xingqing-desktop",
  "productName": "心晴3.0",
  "version": "1.1.0",
  "description": "心晴课表、日程与心情桌面端",
  "author": "hucw-11",
  "private": true,
  "type": "module",
  "main": "main/main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "test:ui": "playwright test",
    "build": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "@playwright/test": "1.65.1"
  },
  "build": {
    "appId": "cn.xingqing.desktop",
    "productName": "心晴3.0",
    "directories": {"output": "dist"},
    "files": ["main/**", "core/**", "ui/**", "package.json"],
    "asar": true,
    "win": {"target": ["nsis", "portable"], "icon": "ui/icon.ico"},
    "nsis": {"artifactName": "Xingqing-Desktop-${version}-Setup-${arch}.${ext}", "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "deleteAppDataOnUninstall": false, "shortcutName": "心晴3.0"},
    "portable": {"artifactName": "Xingqing-Desktop-${version}-Portable-${arch}.${ext}"}
  }
}
